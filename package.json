{
  "name": "dotm5-blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "图形、渲染、Shader、AI 与个人工具实验的中文静态博客",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "new-post:dir": "node scripts/new-post-dir.mjs",
    "generate:assets": "node scripts/generate-brand-assets.mjs",
    "check:contrast": "node scripts/check-design-contrast.mjs",
    "validate:content": "node scripts/validate-content-safety.mjs",
    "format": "biome format --write ./src ./scripts",
    "format:check": "biome format ./scripts ./src/config.ts ./src/content/config.ts ./src/pages/projects.astro ./src/pages/404.astro",
    "lint": "biome check --write ./src ./scripts",
    "lint:check": "biome check --formatter-enabled=false --assist-enabled=false ./src ./scripts",
    "validate:dist": "node scripts/validate-dist.mjs",
    "verify": "node scripts/validate-content-safety.mjs && node scripts/check-design-contrast.mjs && node --test scripts/regressions.test.mjs && astro check && biome check --formatter-enabled=false --assist-enabled=false ./src ./scripts && astro build && pagefind --site dist && node scripts/validate-dist.mjs && node --test scripts/published-output.test.mjs",
    "preinstall": "npx only-allow pnpm",
    "test": "node --test scripts/regressions.test.mjs",
    "test:dist": "node --test scripts/published-output.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "7.2.5",
    "@astrojs/tailwind": "^6.0.2",
    "@expressive-code/core": "^0.44.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.87",
    "@iconify/svelte": "^4.2.0",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "5.18.2",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "hastscript": "^9.0.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "stylus": "^0.64.0",
    "svelte": "^5.56.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@biomejs/biome": "2.5.5",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "@iconify/tools": "4.2.0",
      "postcss": "8.5.18"
    }
  }
}
