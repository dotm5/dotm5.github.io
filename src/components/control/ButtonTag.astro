---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
}
const { dot, href, label }: Props = Astro.props;
---
<a href={href} aria-label={label} class="tag-chip btn-regular h-8 text-sm px-3 rounded-lg">
    {dot && <div class="tag-chip__dot h-1 w-1 transition rounded-md mr-2"></div>}
    <slot></slot>
</a>
