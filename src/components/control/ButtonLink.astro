---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label}
        class:list={`sidebar-link
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            pl-2
            hover:pl-3
            
            text-[var(--ink)]
            hover:text-[var(--accent-ink)]
        `
        }
    >
        <div class="flex h-full items-center justify-between relative mr-2">
            <div class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis  ">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="sidebar-link__badge transition px-2 h-7 ml-4 min-w-[2rem] rounded-lg text-sm font-bold
                    flex items-center justify-center">
                    { badge }
                </div>
            }
        </div>
</a>
