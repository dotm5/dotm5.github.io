/*
 * Structural variables only.
 * All color decisions live in design-tokens.css so the fixed Spring Folio
 * palette cannot drift back to Fuwari's dynamic hue defaults.
 */
:root
  --radius-large: .75rem
  --content-delay: 150ms
  --display-light-icon: 1
  --display-dark-icon: 0
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)

:root.dark
  --display-light-icon: 0
  --display-dark-icon: 1
